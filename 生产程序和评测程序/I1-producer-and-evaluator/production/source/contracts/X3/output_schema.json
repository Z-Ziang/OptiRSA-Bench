{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "allocations"
  ],
  "properties": {
    "decision": {
      "enum": [
        "ACCEPT",
        "REJECT"
      ]
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "path_node_ids",
          "path_link_ids",
          "slot_start"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "path_node_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "integer"
            }
          },
          "path_link_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "slot_start": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "REJECT"
          }
        }
      },
      "then": {
        "properties": {
          "allocations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ACCEPT"
          }
        }
      },
      "then": {
        "properties": {
          "allocations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
