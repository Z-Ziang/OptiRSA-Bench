{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p0/physical_topology.schema.json",
  "title": "PhysicalTopology",
  "type": "object",
  "properties": {
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "REAL",
        "SYNTHETIC"
      ]
    },
    "node_records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/NodeRecord"
      }
    },
    "physical_link_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/PhysicalLinkRecord"
      }
    }
  },
  "required": [
    "topology_id",
    "source_type",
    "node_records",
    "physical_link_records"
  ],
  "additionalProperties": false,
  "$defs": {
    "NodeRecord": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "integer",
          "minimum": 0,
          "description": "当前拓扑内从0开始连续编号；连续性由额外Validator检查。"
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "required": [
        "node_id"
      ],
      "additionalProperties": false
    },
    "PhysicalLinkRecord": {
      "type": "object",
      "properties": {
        "physical_link_id": {
          "type": "integer",
          "minimum": 0
        },
        "node_u_id": {
          "type": "integer",
          "minimum": 0
        },
        "node_v_id": {
          "type": "integer",
          "minimum": 0
        },
        "length_km": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "physical_link_id",
        "node_u_id",
        "node_v_id"
      ],
      "additionalProperties": false
    }
  }
}
