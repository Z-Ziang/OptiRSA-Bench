{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "task_type",
    "topology_id",
    "resource_state_id",
    "nodes",
    "directed_links",
    "slot_count",
    "link_spectrum_states",
    "request",
    "candidate_paths",
    "required_slots_probabilities"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "const": "O2-S"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_state_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "directed_links": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "source_node_id",
          "destination_node_id"
        ],
        "properties": {
          "link_id": {
            "type": "integer",
            "minimum": 0
          },
          "source_node_id": {
            "type": "integer",
            "minimum": 0
          },
          "destination_node_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "slot_count": {
      "type": "integer",
      "minimum": 1
    },
    "link_spectrum_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "slot_availability"
        ],
        "properties": {
          "link_id": {
            "type": "integer",
            "minimum": 0
          },
          "slot_availability": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                0,
                1
              ]
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "source_node_id",
        "destination_node_id",
        "required_slots"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "source_node_id": {
          "type": "integer",
          "minimum": 0
        },
        "destination_node_id": {
          "type": "integer",
          "minimum": 0
        },
        "required_slots": {
          "enum": [
            2,
            3,
            5,
            9
          ]
        }
      }
    },
    "candidate_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_rank",
          "path_node_ids",
          "path_link_ids"
        ],
        "properties": {
          "path_rank": {
            "type": "integer",
            "minimum": 1
          },
          "path_node_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "path_link_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "required_slots_probabilities": {
      "type": "object",
      "description": "当前生产配置下未来业务请求的 required_slots 概率分布；required_slots 已经包含保护槽；该分布用于 WUFR 的精确计算，但它本身不是 WUFR 的需求概率。",
      "propertyNames": {
        "pattern": "^(2|3|5|9)$"
      },
      "additionalProperties": false,
      "required": [
        "2",
        "3",
        "5",
        "9"
      ],
      "properties": {
        "2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "3": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "5": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "9": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
