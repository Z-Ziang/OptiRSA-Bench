{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "task_type",
    "topology_id",
    "resource_state_id",
    "nodes",
    "directed_links",
    "slot_count",
    "link_spectrum_states",
    "required_slots_probabilities",
    "request"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "const": "X2"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_state_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    },
    "directed_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "source_node_id",
          "destination_node_id"
        ],
        "properties": {
          "link_id": {
            "type": "integer",
            "minimum": 0
          },
          "source_node_id": {
            "type": "integer"
          },
          "destination_node_id": {
            "type": "integer"
          }
        }
      }
    },
    "slot_count": {
      "type": "integer",
      "minimum": 1
    },
    "link_spectrum_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "occupied_ranges"
        ],
        "properties": {
          "link_id": {
            "type": "integer",
            "minimum": 0
          },
          "occupied_ranges": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "required_slots_probabilities": {
      "type": "object",
      "required": [
        "2",
        "3",
        "5",
        "9"
      ],
      "additionalProperties": false,
      "properties": {
        "2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "3": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "5": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "9": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "source_node_id",
        "destination_node_id",
        "required_slots"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "source_node_id": {
          "type": "integer"
        },
        "destination_node_id": {
          "type": "integer"
        },
        "required_slots": {
          "enum": [
            2,
            3,
            5,
            9
          ]
        }
      }
    }
  }
}
