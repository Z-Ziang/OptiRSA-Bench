{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GX1 Production Config V2.2",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "seed",
    "topologies",
    "case_counts",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "GX1_PRODUCTION_CONFIG_V2_0",
        "GX1_PRODUCTION_CONFIG_V2_1",
        "GX1_PRODUCTION_CONFIG_V2_2"
      ]
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "topologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "case_counts": {
      "type": "object",
      "required": [
        "G1",
        "G2",
        "G3",
        "X1"
      ],
      "properties": {
        "G1": {
          "type": "integer",
          "minimum": 0
        },
        "G2": {
          "type": "integer",
          "minimum": 0
        },
        "G3": {
          "type": "integer",
          "minimum": 0
        },
        "X1": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "object"
    },
    "pilot_design": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
