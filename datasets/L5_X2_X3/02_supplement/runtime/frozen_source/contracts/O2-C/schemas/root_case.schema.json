{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "task_type",
    "topology_id",
    "resource_state_id",
    "nodes",
    "directed_links",
    "slot_count",
    "link_spectrum_states",
    "requests",
    "required_slots_probabilities",
    "objective_contract_id"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "const": "O2-C"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_state_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "directed_links": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "source_node_id",
          "destination_node_id"
        ],
        "properties": {
          "link_id": {
            "type": "integer",
            "minimum": 0
          },
          "source_node_id": {
            "type": "integer",
            "minimum": 0
          },
          "destination_node_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "slot_count": {
      "type": "integer",
      "minimum": 1
    },
    "link_spectrum_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "slot_availability"
        ],
        "properties": {
          "link_id": {
            "type": "integer",
            "minimum": 0
          },
          "slot_availability": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                0,
                1
              ]
            }
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "source_node_id",
          "destination_node_id",
          "required_slots",
          "candidate_paths"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "source_node_id": {
            "type": "integer",
            "minimum": 0
          },
          "destination_node_id": {
            "type": "integer",
            "minimum": 0
          },
          "required_slots": {
            "enum": [
              2,
              3,
              5,
              9
            ]
          },
          "candidate_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path_rank",
                "path_node_ids",
                "path_link_ids"
              ],
              "properties": {
                "path_rank": {
                  "type": "integer",
                  "minimum": 1
                },
                "path_node_ids": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "path_link_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "required_slots_probabilities": {
      "type": "object",
      "description": "\u5f53\u524d\u751f\u4ea7\u914d\u7f6e\u4e0b\u672a\u6765\u4e1a\u52a1\u8bf7\u6c42\u7684 required_slots \u6982\u7387\u5206\u5e03\uff1brequired_slots \u5df2\u7ecf\u5305\u542b\u4fdd\u62a4\u69fd\uff1b\u8be5\u5206\u5e03\u7528\u4e8e WUFR \u7684\u7cbe\u786e\u8ba1\u7b97\uff0c\u4f46\u5b83\u672c\u8eab\u4e0d\u662f WUFR \u7684\u9700\u6c42\u6982\u7387\u3002",
      "propertyNames": {
        "pattern": "^(2|3|5|9)$"
      },
      "additionalProperties": false,
      "required": [
        "2",
        "3",
        "5",
        "9"
      ],
      "properties": {
        "2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "3": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "5": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "9": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "objective_contract_id": {
      "const": "O2-C_CASE_CONTRACT_V2_0_LEXICOGRAPHIC"
    }
  }
}