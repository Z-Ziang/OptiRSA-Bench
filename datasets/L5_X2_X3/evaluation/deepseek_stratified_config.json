{
  "provider": "openai_compatible",
  "model": "deepseek-v4-pro",
  "base_url": "https://api.deepseek.com",
  "api_key_env": "BENCH_API_KEY",
  "temperature": 0,
  "max_output_tokens": 65536,
  "connections": 8,
  "max_retries": 2,
  "timeout_seconds": 1800,
  "chunk_size": 50,
  "extra_body": {
    "thinking": {
      "type": "enabled"
    },
    "reasoning_effort": "high"
  }
}
