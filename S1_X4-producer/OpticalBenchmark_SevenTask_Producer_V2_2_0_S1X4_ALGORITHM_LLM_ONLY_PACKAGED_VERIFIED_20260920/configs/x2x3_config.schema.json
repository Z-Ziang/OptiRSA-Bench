{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "seed",
    "tasks",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "X2X3_PRODUCTION_CONFIG_V1_0"
    },
    "profile": {
      "enum": [
        "FORMAL",
        "REPRESENTATIVE"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "X2",
        "X3"
      ],
      "properties": {
        "X2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "case_count",
            "required_slots_values",
            "selection",
            "max_simple_paths",
            "max_optimal_actions"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "case_count": {
              "type": "integer",
              "minimum": 0
            },
            "required_slots_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  2,
                  3,
                  5,
                  9
                ]
              }
            },
            "selection": {
              "enum": [
                "PREFIX",
                "LOW_ORACLE_COMPLEXITY"
              ]
            },
            "max_simple_paths": {
              "type": "integer",
              "minimum": 1
            },
            "max_optimal_actions": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "X3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "case_count",
            "request_count_values",
            "selection_values",
            "max_simple_paths_per_request",
            "max_search_nodes",
            "max_complete_optimal_solutions"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "case_count": {
              "type": "integer",
              "minimum": 0
            },
            "request_count_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  2,
                  4,
                  8,
                  12
                ]
              }
            },
            "selection_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "PREFIX",
                  "HIGH_CONFLICT_X3"
                ]
              }
            },
            "max_simple_paths_per_request": {
              "type": "integer",
              "minimum": 1
            },
            "max_search_nodes": {
              "type": "integer",
              "minimum": 1
            },
            "max_complete_optimal_solutions": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_shortfall"
      ],
      "properties": {
        "allow_shortfall": {
          "type": "boolean"
        }
      }
    }
  }
}
