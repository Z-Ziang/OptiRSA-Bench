{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p0/request.schema.json",
  "title": "Request",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "source_node_id": {
      "type": "integer",
      "minimum": 0
    },
    "destination_node_id": {
      "type": "integer",
      "minimum": 0
    },
    "required_slots": {
      "type": "integer",
      "enum": [
        2,
        3,
        5,
        9
      ]
    }
  },
  "required": [
    "request_id",
    "topology_id",
    "source_node_id",
    "destination_node_id",
    "required_slots"
  ],
  "additionalProperties": false
}
