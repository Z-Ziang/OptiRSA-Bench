{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "intent_type",
    "requests",
    "objectives"
  ],
  "additionalProperties": false,
  "properties": {
    "intent_type": {
      "const": "CONCURRENT"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "source_node_id",
          "destination_node_id",
          "required_slots"
        ],
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "source_node_id": {
            "type": "integer",
            "minimum": 0
          },
          "destination_node_id": {
            "type": "integer",
            "minimum": 0
          },
          "required_slots": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "enum": [
          "MIN-HOP-COUNT",
          "MIN-FRAGMENTATION",
          "MIN-TOTAL-SLOT-USAGE",
          "MAX-ACCEPTED-REQUESTS",
          "MIN-EXTERNAL-FRAGMENTATION"
        ]
      },
      "uniqueItems": true
    }
  }
}
