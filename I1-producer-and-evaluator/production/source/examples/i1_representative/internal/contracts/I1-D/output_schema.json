{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "intent_type",
    "request",
    "objectives"
  ],
  "additionalProperties": false,
  "properties": {
    "intent_type": {
      "const": "DYNAMIC"
    },
    "request": {
      "type": "object",
      "required": [
        "request_id",
        "source_node_id",
        "destination_node_id",
        "required_slots",
        "arrival_time",
        "holding_time"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "source_node_id": {
          "type": "integer",
          "minimum": 0
        },
        "destination_node_id": {
          "type": "integer",
          "minimum": 0
        },
        "required_slots": {
          "type": "integer",
          "minimum": 1
        },
        "arrival_time": {
          "type": "number",
          "minimum": 0
        },
        "holding_time": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "enum": [
          "MIN-HOP-COUNT",
          "MIN-FRAGMENTATION",
          "MIN-TOTAL-SLOT-USAGE",
          "MAX-ACCEPTED-REQUESTS",
          "MIN-EXTERNAL-FRAGMENTATION"
        ]
      },
      "uniqueItems": true
    }
  }
}
