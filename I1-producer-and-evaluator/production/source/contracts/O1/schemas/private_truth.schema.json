{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "task_type",
    "joint_feasible",
    "optimal_wufr",
    "reference_output"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "task_type": {
      "const": "O1"
    },
    "joint_feasible": {
      "type": "boolean"
    },
    "optimal_wufr": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "equivalent_optimum_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "reference_output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "allocations"
      ],
      "properties": {
        "decision": {
          "enum": [
            "ACCEPT",
            "REJECT"
          ]
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "slot_start"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1
              },
              "slot_start": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "REJECT"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "allocations": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "ACCEPT"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "allocations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
